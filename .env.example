# ==============================================================================
# BillGuard Environment Configuration (Template)
# Copy this file to .env.local (for local dev) or set via environment in AWS.
# NEVER commit real API keys, credentials, or secrets to Git.
# ==============================================================================

# Server Environment Mode (development | production)
ENVIRONMENT=development

# Google Gemini API Key (Required for AI OCR and Electricity Assistant)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Region & Cloud Infrastructure (DynamoDB & S3)
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_NAME=BillGuardAudits
S3_BUCKET_NAME=billguard-documents-pream-2026

# Optional: CORS Allowed Origins (Comma-separated in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://main.d3nztc0st9o9ku.amplifyapp.com

# Backend API URL for Next.js Client (Default: http://127.0.0.1:8000 or Elastic Beanstalk URL)
NEXT_PUBLIC_API_URL=http://billguard-api-prod.eba-szpxm8he.ap-southeast-2.elasticbeanstalk.com

